# NiryatFlow AI — Environment Configuration
# NOTE: Both variables below are OPTIONAL for Sample Business Workspace (Zero-Cost Demo Mode).
# Do NOT add PAYPAL_SANDBOX_CLIENT_SECRET to this file or the Android client.
# For Production PayPal Sandbox integration, store PAYPAL_SANDBOX_CLIENT_SECRET in Firebase Secret Manager.
PAYPAL_SANDBOX_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_BACKEND_BASE_URL=OPTIONAL_DEMO_MODE
