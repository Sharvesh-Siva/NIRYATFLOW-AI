# PAYPAL_SANDBOX_CLIENT_ID: PayPal Sandbox REST API Client ID (configure via AI Studio Secrets panel)
PAYPAL_SANDBOX_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID

# PAYPAL_SANDBOX_CLIENT_SECRET: PayPal Sandbox REST API Secret (configure via AI Studio Secrets panel)
PAYPAL_SANDBOX_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
